# Gemini API Key for Multimodal AI OCR & Agent extraction
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets Configuration
# 1. Your Google Spreadsheet ID from the URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# 2. Service Account Credentials (Option A: Separate Fields)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASC...==\n-----END PRIVATE KEY-----\n"

# 2. Service Account Credentials (Option B: Complete JSON string or base64 encoded)
# GOOGLE_SERVICE_ACCOUNT_JSON=


# Optional: override the Gemini model (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
# Optional: comma-separated fallback models if the primary is overloaded
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest

# --- Alternative to the service account: Google Apps Script web app (see README) ---
# APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
# APPS_SCRIPT_TOKEN=a-long-random-string-you-also-put-in-Script-Properties-as-API_TOKEN
